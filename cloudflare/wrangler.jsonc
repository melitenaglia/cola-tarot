{
  "name": "soy-amor-eventos-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soy-amor-eventos-staging",
      "database_id": "6cc90522-6291-442d-85ac-814298d0213a"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.css",
        "**/*.txt"
      ],
      "fallthrough": true
    }
  ]
}
